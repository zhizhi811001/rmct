<https://zhizhi811001.github.io/rmct/> a owl:Ontology ;
    dcterms:description "A SKOS taxonomy for representing regional manufacturing capabilities across processes, materials, quality, engineering, digital production, delivery readiness, sector experience, and sustainability."@en ;
    dcterms:issued "2026-07-30"^^xsd:date ;
    dcterms:title "Regional Manufacturing Capability Taxonomy (RMCT) v1.0"@en ;
    owl:versionInfo "1.0.0-draft" .

<https://zhizhi811001.github.io/rmct/concept/2d-drafting> a skos:Concept ;
    skos:broader <https://zhizhi811001.github.io/rmct/concept/computer-aided-design> ;
    skos:definition "The capability to perform, support, test, manage, or demonstrate 2d drafting as part of computer-aided design."@en ;
    skos:inScheme <https://zhizhi811001.github.io/rmct/scheme/rmct> ;
    skos:scopeNote "Assign when there is explicit evidence of organisational capability or experience in 2d drafting."@en ;
    ns1:prefLabel <https://zhizhi811001.github.io/rmct/label/2d-drafting-en> .

<https://zhizhi811001.github.io/rmct/concept/3d-solid-modelling> a skos:Concept ;
